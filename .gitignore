# Data files (keep examples, remove large data)
skills/*/data/*.json.bak
skills/*/data/*.json.e2e-backup
skills/*/logs/*.log
skills/*/cache/*.json

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Next.js / frontend build
.next/
*.tsbuildinfo

