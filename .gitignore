screenshots/
*__screenshot__*
*.screenshot.png
dashboard-*.png
ssa-*.png

# Runtime logs and local caches
logs/
*.log
.cache/

# New generated data in repo data/ dir (existing tracked files unaffected)
data/*.json
data/*.csv
data/*.html
data/*.xlsx
data/*.pdf
data/intelligence/
!data/README*

# New lead CSVs from runtime scans (keep tracked samples)
hero-pumps/leads/*-scan-*.csv

