# SSA Environment Variables (Server)
# Deploy to: /var/www/ssa/.env
# File permissions: chmod 600 /var/www/ssa/.env
#
# This is the SINGLE source of truth for all SSA secrets.
# PM2 processes load this via env_file — no secrets in version control.

# ── Server ──────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ── Runtime Data Boundary ───────────────────────
# SSA writes runtime state outside the repo. Keep this on persistent storage.
SSA_DATA_ROOT=/var/www/ssa/shared/data

# ── External Side-Effect Safety ─────────────────
# Leave these unset/false for public beta unless the specific adapter has been
# reviewed and the action is approved through the side-effect gate. Real
# customer email sends also require an explicit human approval marker from SSA.
SSA_ENABLE_REAL_IMAP=false
SSA_ENABLE_REAL_EMAIL_SEND=false
SSA_ENABLE_REAL_CRM_WRITE=false
SSA_ENABLE_REAL_FEISHU=false
SSA_ENABLE_REAL_PAYMENT=false
SSA_ENABLE_REAL_BANK=false
SSA_ENABLE_REAL_DOCUMENT_GENERATION=false
SSA_ENABLE_REAL_DOCUMENT_PREVIEW=false
# Emergency override only. Keep false for public beta; real cold sends should
# require Hunter verification unless an operator explicitly accepts the risk.
SSA_ALLOW_UNVERIFIED_EMAIL_SEND=false

# ── Feishu (Lark) ──────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_WEBHOOK_URL=

# ── Email (IMAP/SMTP) ──────────────────────────
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ── Cold Email Verification ─────────────────────
HUNTER_API_KEY=

# ── Database (SQLite — path on server) ─────────
DATABASE_PATH=/var/www/ssa/shared/data/crm.db
SQLITE_DB_PATH=/var/www/ssa/shared/data/ssa.db

# ── SSA LLM Provider ────────────────────────────
# Supported by the web runtime: deepseek, openai, openrouter, mock.
# If SSA_LLM_PROVIDER is blank, the runtime auto-detects DEEPSEEK_API_KEY first,
# then OPENAI_API_KEY, then OPENROUTER_API_KEY. Without a supported key it falls
# back to the local mock.
SSA_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENROUTER_API_KEY=
SSA_LLM_MODEL=deepseek-v4-flash

# ── Headless API ────────────────────────────────
HEADLESS_API_URL=http://127.0.0.1:3001
HEADLESS_API_KEY=

# ── Backend ─────────────────────────────────────
SSA_API_PORT=3456
SSA_API_HOST=127.0.0.1
SSA_MODE=production
SSA_API_KEY=

# ── Observability API ────────────────────────────
# Separate key from SSA_API_KEY — least privilege
SSA_OBS_API_KEY=
# 允许访问 observability API 的 CORS origin（默认 localhost）
SSA_OBS_CORS_ORIGIN=http://localhost:3210

# ── Legacy backend direct LLM vars ──────────────
# Keep blank unless a non-web backend process explicitly requires them.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
