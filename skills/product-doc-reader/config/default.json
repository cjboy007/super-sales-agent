{
  "format": "both",
  "output_dir": "./output",
  "confidence_threshold": 80,
  "cache_dir": ".cache/vision",
  "vision": {
    "provider": "openrouter",
    "model": "google/gemini-2.5-flash",
    "fallback_required_fields": ["product_name", "drawing_no", "packaging_spec"]
  },
  "validation": {
    "min_model_length": 3,
    "min_product_name_length": 4,
    "reject_model_prefixes": ["BJ", "599"],
    "reject_product_prefixes": ["BJ", "599"],
    "reject_product_regexes": [
      "^\\d+$",
      "^\\d+[A-Z]+$",
      ".*BC$"
    ],
    "exclude_words": [
      "HDMI",
      "AWM",
      "STYLE",
      "VW",
      "PIN",
      "SHELL",
      "ROHS",
      "REACH",
      "PVC",
      "SKW",
      "FARREACH",
      "DP",
      "USB",
      "AOC",
      "CABLE",
      "GRIP",
      "HDR",
      "GR",
      "CM",
      "FM",
      "AM",
      "AF",
      "MM",
      "MLS",
      "MODEL",
      "SCREW",
      "PLATED",
      "NUT",
      "PLUG",
      "PASS",
      "TEST",
      "HDPE",
      "SKIN",
      "BLACK",
      "TPE",
      "DRAIN",
      "WIRE",
      "AL",
      "MY",
      "BC",
      "PE",
      "OD",
      "CONDUCTOR",
      "BRAID",
      "JACKET",
      "COLOR",
      "COPPER",
      "FOIL",
      "FABRIC",
      "RUBBERIZED",
      "IRON",
      "GOLD",
      "SHEATH",
      "CLIP",
      "NI",
      "ETHERNET",
      "HIGH",
      "SPEED",
      "WITH",
      "E358026",
      "VW-1",
      "OPEN",
      "SHORT",
      "MISS",
      "CONTACT",
      "RESISTANCE",
      "INSULATION",
      "HI-POT",
      "HDTV-DVD"
    ]
  },
  "table_extraction": {
    "header_keywords": ["客人品名", "CUSTOMER ITEM"],
    "stop_keywords": ["NO.", "部件名称", "PART NAME", "规格", "用量", "UNIT"],
    "max_rows_after_header": 16,
    "require_any_field": ["length_mm", "packaging_spec", "material_code"]
  },
  "templates": [
    {
      "id": "farreach_599",
      "label": "Farreach 599 series",
      "patterns": ["599-\\d{2,3}", "FARREACH", "福睿"],
      "drawing_no_regex": "\\b(599-\\d{2,3})\\b"
    },
    {
      "id": "customer_c331",
      "label": "Customer C331 drawing",
      "patterns": ["\\bC331\\b", "CUSTOMER DRAWING"]
    },
    {
      "id": "english_title_block",
      "label": "English title block",
      "patterns": ["DRAWING NO\\.", "MODEL NO\\.", "CUSTOMER ITEM"]
    }
  ]
}
