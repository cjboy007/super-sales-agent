# Farreach email profile example.
# Copy values to ~/.config/super-sales-agent/profiles/farreach.env.
# Do not put real credentials in this project folder.

IMAP_HOST=imaphz.qiye.163.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=sales@example.com
IMAP_PASS=replace-with-provider-app-password
IMAP_REJECT_UNAUTHORIZED=true

SMTP_HOST=smtphz.qiye.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sales@example.com
SMTP_PASS=replace-with-provider-app-password
SMTP_FROM=sales@example.com
SMTP_SENDER_NAME=Sales
