# Local web runtime
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=development

# Runtime data must stay outside the repository.
SSA_DATA_ROOT=../.local/ssa-data

# Use mock for local development and CI unless you intentionally test a provider.
SSA_LLM_PROVIDER=mock
SSA_LLM_MODEL=
SSA_LLM_BASE_URL=
SSA_LLM_API_KEY=

# Optional provider-specific keys. Leave blank unless used locally.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
HUNTER_API_KEY=

# External side effects are disabled by default.
SSA_ENABLE_REAL_IMAP=false
SSA_ENABLE_REAL_EMAIL_SEND=false
SSA_ENABLE_REAL_CRM_WRITE=false
SSA_ENABLE_REAL_FEISHU=false
SSA_ENABLE_REAL_PAYMENT=false
SSA_ENABLE_REAL_BANK=false
SSA_ENABLE_REAL_DOCUMENT_GENERATION=false
SSA_ENABLE_REAL_DOCUMENT_PREVIEW=false
SSA_ALLOW_UNVERIFIED_EMAIL_SEND=false

# Optional local gateway settings.
SSA_LOCAL_GATEWAY=false
SSA_BIND_HOST=127.0.0.1
SSA_PUBLIC_HOST=127.0.0.1
SSA_PUBLIC_PORT=3000
