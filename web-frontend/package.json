{
  "name": "super-sales-agent-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node ../scripts/prepare-next-standalone.mjs . && cd .next/standalone && SSA_APP_ROOT=$PWD node server.js",
    "worker": "node ../scripts/workers/jaden-worker.mjs --workspace farreach --worker-id jaden-local --max-jobs 5 --max-attempts 3",
    "worker:once": "node ../scripts/workers/jaden-worker.mjs --workspace farreach --worker-id jaden-local --max-jobs 5 --max-attempts 3 --once",
    "worker:status": "node ../scripts/workers/jaden-worker.mjs --status --worker-id jaden-local",
    "worker:supervisor": "node ../scripts/workers/jaden-worker-supervisor.mjs generate --workspace farreach --worker-id jaden-local",
    "lint": "next lint",
    "test": "node ../scripts/run-web-tests.mjs",
    "test:workers": "node --test ../scripts/workers/jaden-worker.test.mjs ../scripts/workers/jaden-worker-supervisor.test.mjs ../scripts/workers/inbox-monitor.test.mjs ../scripts/legacy-outbound-approval.test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fast-xml-parser": "^5.8.0",
    "jiti": "^1.21.7",
    "next": "15.5.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "glob": "^11.0.0",
    "postcss": "8.5.15"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "15.5.18",
    "postcss": "8.5.15",
    "tailwindcss": "^3.4.14",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
